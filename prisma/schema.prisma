generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  FUNCIONARIO
}

model Usuario {
  id    String     @id @default(uuid())
  name  String
  email String  @unique
  login String  @unique
  password String
  role  Role    @default(FUNCIONARIO)
  createdAt DateTime @default(now())
  status Boolean @default(true)
}